<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- This project targets the v8 collection: Landis.Core 3.0.1 and
         Landis.SpatialModeling 2.0.1 exist only on the landis-ii-v8 feed.
         Without it, restore fails NU1102 on any machine without a warm
         NuGet cache; the v7 feed tops out at 2.0.0 for both. -->
    <add key="landis-ii-v8" value="https://www.myget.org/F/landis-ii-v8/api/v3/index.json" />
    <add key="landis-ii-v7" value="https://www.myget.org/F/landis-ii-v7/api/v3/index.json" />
  </packageSources>
</configuration>